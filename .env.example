MONGODB_URI=
MONGODB_DB=nextrole
APP_URL=http://localhost:3000
SMTP_URL=
MAIL_FROM=
# OpenAI-compatible Chat Completions API with JSON schema support
AI_API_KEY=
AI_MODEL=gpt-6.1
AI_BASE_URL=https://api.openai.com/v1

# Optional portal OAuth application credentials
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
INDEED_CLIENT_ID=
INDEED_CLIENT_SECRET=

# Optional LinkedIn job search. Requires app-level access to LinkedIn job search.
LINKEDIN_SEARCH_CLIENT_ID=
LINKEDIN_SEARCH_CLIENT_SECRET=

# NVIDIA-hosted resume parsing
# Use nvidia to select NVIDIA, or openai-compatible for the existing provider.
AI_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Streamable HTTP MCP server exposing search-jobs with app-level public listings.
LINKEDIN_MCP_URL=
LINKEDIN_MCP_TOKEN=

# Composio-managed LinkedIn profiles
COMPOSIO_API_KEY=
COMPOSIO_LINKEDIN_AUTH_CONFIG_ID=

# Optional comma-separated Greenhouse board-token:Employer Name pairs for recommendations
GREENHOUSE_JOB_BOARDS=

# Optional authorized job-search feed gateways. Each returns { jobs: [{ id, title, company, location, url, description? }] }.
LINKEDIN_JOBS_FEED_URL=
LINKEDIN_JOBS_FEED_TOKEN=
NAUKRI_JOBS_FEED_URL=
NAUKRI_JOBS_FEED_TOKEN=
INDEED_JOBS_FEED_URL=
INDEED_JOBS_FEED_TOKEN=
GLASSDOOR_JOBS_FEED_URL=
GLASSDOOR_JOBS_FEED_TOKEN=
MONSTER_JOBS_FEED_URL=
MONSTER_JOBS_FEED_TOKEN=
